TASTYTRADE_CLIENT_ID=your-tastytrade-oauth-client-id
TASTYTRADE_CLIENT_SECRET=your-tastytrade-oauth-client-secret
TASTYTRADE_REFRESH_TOKEN=your-tastytrade-oauth-refresh-token

# Message @BotFather to create a bot and get TELEGRAM_BOT_TOKEN; message the
# bot once, then hit https://api.telegram.org/bot<token>/getUpdates to read
# chat.id for TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
